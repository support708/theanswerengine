{
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/cron/blog?action=remind",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/blog?action=publish",
      "schedule": "0 22 * * 1-5"
    },
    {
      "path": "/api/cron/retrospective",
      "schedule": "0 18 * * 5"
    },
    {
      "path": "/api/cron/reddit",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reddit-digest",
      "schedule": "7 * * * *"
    }
  ]
}
