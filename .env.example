# Anthropic API - for research and report generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Admin Authentication
ADMIN_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here
NEXTAUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=https://theanswerengine.ai

# Telegram Bot Notifications (optional - pipeline status updates)
# Create a bot via @BotFather, get the token
# Get your chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lead Hunter Bot
# CRON_SECRET protects the /api/cron/* endpoints (generate with: openssl rand -base64 32)
CRON_SECRET=generate-a-random-secret-here
HUNT_ENABLED=true
HUNT_MAX_LEADS_PER_SESSION=10

# Blog Bot (automated article publishing)
BLOG_ENABLED=true

# Success notifications — when true, every pipeline cron sends a Telegram summary on completion (counts + samples)
# Off by default. Set to 'true' in Vercel env vars when you want the win-stream.
ENABLE_SUCCESS_NOTIFS=false

# To generate a bcrypt hash for your admin password, run:
#   node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your-password', 10).then(h => console.log(h))"
#
# To generate NEXTAUTH_SECRET, run:
#   openssl rand -base64 32
